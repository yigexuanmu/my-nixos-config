// --- NIRI BLUR START ---
// 顶层的blur配置，细节调整blur的效果
blur {
  passes 3
  offset 3
  noise 0.02
  saturation 1.5
}
// 全局窗口规则。让所有普通窗口以xray的形式显示blur。xray仅渲染一次模糊版本的背景，然后将其以类似"壁纸"的形式显示在窗口后面，不是实时渲染模糊，所以完全没有性能消耗。
window-rule {
    match app-id=".*"
    background-effect {
        xray false
        blur true
    }
}
// 浮动窗口禁用xray可以实时渲染模糊效果但是性能消耗高，开启xray会穿过浮动窗口底下的窗口直接透视到桌面。看个人喜好选择禁用与否吧。
window-rule {
    match app-id=".*"
    match is-floating=true
    background-effect {
       xray false
       blur true
    }
}

// ─────────────────────────────────────────────────────────────
// 光标特效（niri-mioha fork 新增）。长度单位 = 1080p 参考像素，
// 时间单位 = 毫秒。下面是上游 1:1 标定出来的默认值，改数字即可试。
// 现场调整：改完存盘，niri 不会自动重载，用 Mod+Shift+R
// （或 niri msg action reload-config）重新读。
// ─────────────────────────────────────────────────────────────
cursor-effect {
    enabled true
    scale 0.8
    opacity 1
    tint "255,255,255"
    use-linked-animation-speed true
    effect-speed 1.0
    trail-speed 1.0
    click-speed 1.0
    trail-refresh-rate 165
    enable-always-trail false
    apply-curve-draw false
    // 新写法：显式列表，写了谁就只有谁。下面这行 = 左键 + 中键 + 后退键
    // （旧的 click-trigger / enable-middle-click-trigger 会被完全忽略）
    trigger-buttons "left" "middle" "back"
    click-trigger "left"
    enable-middle-click-trigger true
    hide-in-fullscreen true
    show-on-desktop true
    touch-mode false

    disk {
        radius 64.8
        lifetime 200
    }
    rings {
        count 2
        lifetime 600
        radius-min 68.93
        radius-max 80.41
        spin 11.17
        spin-direction -1
        inner-ratio 0.9401275
        hdr-intensity 5.992157
    }
    shards {
        count 4
        lifetime-min 600
        lifetime-max 700
        radius 49.88
        speed-min 49.88
        speed-max 66.5
        size-min 16.63
        size-max 33.25
        hdr-intensity 5.992157
    }
    trail {
        width 1.0
        opacity 1.0
        length 1.0
    }
    glow {
        // 雾（辉光）总增益。乘以 `BLOOM_GAIN`，作用在**所有**材质上。
        // 保持 1.0，点击效果的辉光才是上游原样。
        gain 1
        radius 1.0
        // 额外作用在**拖尾**雾上的增益，不影响点击特效。
        //   1.00 → 上游原样（最浓）
        //   0.75 → 略淡
        //   0.55 → 明显更透、更淡（当前）
        //   0.40 → 只剩贴核的薄雾
        // 改完保存即热重载生效。
        trail-gain 1.1
    }
}
